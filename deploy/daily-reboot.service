[Unit]
Description=Daily 04:00 proactive reboot (keeps the Pi in a known-good state)
# No RTC: the clock boots stale at ~04:00 and would fire this immediately. Wait for a real
# clock so the trigger reflects actual 04:00, not the restored fake time. The script guards too.
After=time-sync.target
Wants=time-sync.target
[Service]
Type=oneshot
ExecStart=/root/mydoorcamera/deploy/daily-reboot.sh
